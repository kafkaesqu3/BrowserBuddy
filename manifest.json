{
  "manifest_version": 3,
  "name": "Tab Screen Recorder",
  "version": "1.0",
  "description": "Record your current browser tab with screen capture and take screenshots",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Screen Recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js"],
      "matches": ["<all_urls>"]
    }
  ]
}